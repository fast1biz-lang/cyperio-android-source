<?xml version="1.0" encoding="utf-8"?>
<!-- Cyperio: the home screen. Always dark, in the brand colours (same design as the Windows app):
     a connect button that shows its state, a country card with the flag, session clock + exit
     address while connected, time and data left as bars. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cy_navy"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/home_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="52dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/cy_text"
                    android:textDirection="ltr"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cy_muted"
                    android:textDirection="ltr"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/cy_pill"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/cy_muted"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/home_gear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_settings"
                android:src="@drawable/ic_settings_24dp"
                app:tint="@color/cy_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/home_power"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:clickable="true"
                android:contentDescription="@string/cyperio_connect"
                android:focusable="true">

                <View
                    android:id="@+id/home_halo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cy_oval" />

                <ProgressBar
                    android:id="@+id/home_spin"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/cy_amber"
                    android:visibility="gone" />

                <View
                    android:id="@+id/home_core"
                    android:layout_width="134dp"
                    android:layout_height="134dp"
                    android:layout_gravity="center"
                    android:background="@drawable/cy_core_off" />

                <ImageView
                    android:id="@+id/home_power_icon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cyperio_power" />
            </FrameLayout>

            <TextView
                android:id="@+id/home_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/cy_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:minHeight="22dp"
                android:textColor="@color/cy_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_country_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cy_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/home_flag"
                android:layout_width="38dp"
                android:layout_height="24dp"
                android:background="@drawable/cy_flag_bg"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_country_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cy_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_country_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/cy_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="@color/cy_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/cy_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cyperio_time_left"
                    android:textColor="@color/cy_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/home_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/cy_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/home_days_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="9dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/cy_bar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/cy_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cyperio_data_left"
                    android:textColor="@color/cy_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/home_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/cy_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/home_data_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="9dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/cy_bar" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/home_warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/cy_amber_bg"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/cy_amber"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/home_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/cy_teal_bg"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="@color/cy_teal_soft"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/home_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cy_navy"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/cyperio_welcome_title"
            android:textColor="@color/cy_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/cyperio_welcome_message"
            android:textColor="@color/cy_muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/home_link"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/cy_input"
            android:hint="@string/cyperio_welcome_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/cy_text"
            android:textColorHint="@color/cy_muted"
            android:textDirection="ltr"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_setup_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:minHeight="20dp"
            android:textColor="@color/cy_red"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_activate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/cy_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cyperio_welcome_activate"
            android:textColor="#042F2E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_paste"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/cy_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cyperio_paste"
            android:textColor="@color/cy_teal"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/home_scan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/cy_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cyperio_welcome_scan"
            android:textColor="@color/cy_teal"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/home_setup_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="@android:string/cancel"
            android:textColor="@color/cy_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/home_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:indeterminateTint="@color/cy_teal"
        android:visibility="gone" />
</FrameLayout>
