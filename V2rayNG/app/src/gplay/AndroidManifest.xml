<?xml version="1.0" encoding="utf-8"?>
<!-- Cyperio, Google Play build: the "query all packages" permission is removed (Play rarely allows it). The per-app VPN picker
     only needs the apps a person can open, so it sees the apps with a launcher icon instead
     (getInstalledPackages() then returns just those). The APK flavor keeps the full permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
